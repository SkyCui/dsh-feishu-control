# DeepSeek model credential used by the installed DSH base profile.
DEEPSEEK_API_KEY=replace-with-your-deepseek-key

# Feishu Open Platform application credentials.
FEISHU_CONTROL_APP_ID=replace-with-your-app-id
FEISHU_CONTROL_APP_SECRET=replace-with-your-app-secret

# Comma-separated Feishu open_id values. Empty or missing denies every sender.
FEISHU_CONTROL_ALLOWED_OPEN_IDS=replace-with-your-open-id

# Dedicated project directory the remotely controlled Agent may access.
FEISHU_CONTROL_WORKSPACE=/absolute/path/to/a/project

# Recommended Harness sandbox mode for remotely triggered agents.
FEISHU_CONTROL_PERMISSION_MODE=workspace-write

# Optional model route for Feishu-created agents. Each variable independently
# pins its field. While a route field remains unset, it and reasoning effort
# follow the live `agent-default-model`; set both to opt into a fully fixed route.
# FEISHU_CONTROL_PROVIDER=deepseek-official
# FEISHU_CONTROL_MODEL=deepseek-v4-flash
